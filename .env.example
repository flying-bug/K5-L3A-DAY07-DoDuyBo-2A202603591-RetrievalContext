# Agent provider: openai | gemini. Empty = openai when OPENAI_API_KEY is set, otherwise gemini.
AGENT_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Gemini (free tier of gemini-2.5-flash allows only 20 requests/day)
GEMINI_API_KEY=
AGENT_MODEL=gemini-2.5-flash
# Optional list prices (USD / 1M tokens) for the cost estimate if you change model
AGENT_PRICE_IN=
AGENT_PRICE_OUT=
# Day 6 pgvector store (local Docker from the Day 6 repo, starter/docker-compose.yml)
DAY6_DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
# Optional: EmbeddingGemma folder or HF id; default = ../models/embeddinggemma-300m next to this repo
EMBEDDING_MODEL=
